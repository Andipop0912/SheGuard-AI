# SheGuard AI Backend Environment Configuration
# Copy to .env for local development. NEVER commit the real .env file or real secret values.

ENVIRONMENT=development
# Render/most PaaS hosts inject PORT automatically — only needed for manual local runs.
PORT=8000
DATABASE_URL=postgresql://sheguard_user:sheguard_password@localhost:5432/sheguard_db
JWT_SECRET=dev_secret_key_change_in_production_32bytes_min_length
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated origins, or "*" (mobile HTTP clients are not subject to browser CORS at all).
CORS_ORIGINS=*

# Communication Dispatch Engine Configuration
COMMUNICATION_PROVIDER_MODE=mock  # Options: mock | real — see README "Real Fast2SMS" section
SMS_PROVIDER=fast2sms             # Options: fast2sms | mock
MAX_DISPATCH_RETRIES=2
HTTP_REQUEST_TIMEOUT_SECONDS=5.0

# Fast2SMS Gateway Configuration (Required ONLY when COMMUNICATION_PROVIDER_MODE=real)
FAST2SMS_API_KEY=
FAST2SMS_BASE_URL=https://www.fast2sms.com/dev/bulkV2

# Opt-in Real SMS Integration Test Flag (Must remain false in automated test suites)
RUN_REAL_SMS_TESTS=false

# Route Safety: base URL the client's SMS live-location link points to. Must be the real
# deployed backend URL in production (the dev default only works over the adb/LAN tunnel).
ROUTE_SAFETY_LIVE_BASE_URL=http://localhost:8000/api/v1/route-safety/live

# Supabase Storage: private bucket for evidence audio + incident report PDFs.
# URL/bucket are not secrets; SUPABASE_SECRET_KEY (service-role key) is server-only.
SUPABASE_URL=https://iulrqqygrnbzoqkpwciu.supabase.co
SUPABASE_BUCKET=sheguard-evidence
SUPABASE_SECRET_KEY=
SUPABASE_SIGNED_URL_TTL_SECONDS=3600

# Ask SheGuard AI (Gemini) — server-side only, never sent to the mobile app.
GEMINI_API_KEY=
GEMINI_MAX_OUTPUT_TOKENS=512
