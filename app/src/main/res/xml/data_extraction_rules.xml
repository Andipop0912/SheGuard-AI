<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The encrypted session store is excluded from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sheguard_secure_store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sheguard_secure_store.xml" />
    </device-transfer>
</data-extraction-rules>
